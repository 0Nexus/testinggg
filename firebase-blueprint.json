{
  "entities": {
    "users": {
      "title": "User",
      "description": "User account profiles (Homeowners, Contractors, Inspectors/Admins)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "companyName": { "type": "string" },
        "role": { "type": "string", "enum": ["homeowner", "contractor", "inspector", "admin"] },
        "phone": { "type": "string" },
        "passwordHash": { "type": "string" },
        "createdAt": { "type": "string" },
        "contractorProfile": {
          "type": "object",
          "properties": {
            "companyName": { "type": "string" },
            "tradeType": { "type": "string" },
            "hourlyRateGBP": { "type": "number" },
            "fixedQuoteEstimateGBP": { "type": "number" },
            "certifications": { "type": "array", "items": { "type": "string" } },
            "bio": { "type": "string" },
            "avatarUrl": { "type": "string" },
            "availability": { "type": "string" }
          }
        }
      },
      "required": ["email", "name", "role", "passwordHash"]
    },
    "vettedContractors": {
      "title": "Vetted Contractor",
      "description": "Vetted contractor directory and discovered trade specialists",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "companyName": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "tradeType": { "type": "string" },
        "certifications": { "type": "array", "items": { "type": "string" } },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "completedJobsCount": { "type": "number" },
        "hourlyRateGBP": { "type": "number" },
        "fixedQuoteEstimateGBP": { "type": "number" },
        "availability": { "type": "string" },
        "distanceMiles": { "type": "number" },
        "bio": { "type": "string" },
        "isExternalDiscovered": { "type": "boolean" },
        "invitationStatus": { "type": "string" },
        "invitedAt": { "type": "string" }
      },
      "required": ["name", "companyName", "tradeType", "hourlyRateGBP"]
    },
    "projects": {
      "title": "Repair Job / Project",
      "description": "Renovation jobs, milestones, escrow holds, and extra variation pay requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "clientId": { "type": "string" },
        "assignedContractorId": { "type": "string" },
        "assignedContractorName": { "type": "string" },
        "contractorStatus": { "type": "string" },
        "totalAmount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "damageDescription": { "type": "string" },
        "damageImages": { "type": "array", "items": { "type": "string" } },
        "milestones": { "type": "array" },
        "extraPayRequests": { "type": "array" }
      },
      "required": ["title", "clientName", "totalAmount"]
    },
    "transactions": {
      "title": "Payment Transaction",
      "description": "Escrow transaction records and gateway payout logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "projectTitle": { "type": "string" },
        "milestoneId": { "type": "string" },
        "milestoneTitle": { "type": "string" },
        "clientName": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "gateway": { "type": "string" },
        "paymentMethodUsed": { "type": "string" },
        "status": { "type": "string" },
        "gatewayRef": { "type": "string" },
        "feeAmount": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["projectId", "amount", "gateway"]
    },
    "mcpRules": {
      "title": "MCP Routing Rule",
      "description": "Merchant Custom Payment routing rules and threshold criteria",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "conditionType": { "type": "string" },
        "operator": { "type": "string" },
        "value": { "type": "string" },
        "targetGateway": { "type": "string" },
        "priority": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "targetGateway"]
    },
    "gatewayConfig": {
      "title": "Gateway Configuration",
      "description": "Global Stripe and Airwallex configuration and fee structures",
      "type": "object",
      "properties": {
        "mcpMode": { "type": "string" },
        "mcpDefaultGateway": { "type": "string" },
        "stripe": { "type": "object" },
        "airwallex": { "type": "object" }
      },
      "required": ["mcpMode"]
    },
    "invitationLogs": {
      "title": "Contractor Invitation Log",
      "description": "Logs of invitations dispatched to trade specialists",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "contractorEmail": { "type": "string" },
        "companyName": { "type": "string" },
        "tradeCategory": { "type": "string" },
        "jobTitle": { "type": "string" },
        "sentAt": { "type": "string" },
        "inviteToken": { "type": "string" },
        "deliveryStatus": { "type": "string" },
        "invitedBy": { "type": "string" }
      },
      "required": ["contractorEmail", "inviteToken"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profiles and credentials"
    },
    "/vettedContractors/{contractorId}": {
      "schema": "vettedContractors",
      "description": "Vetted trade contractor entries"
    },
    "/projects/{projectId}": {
      "schema": "projects",
      "description": "Renovation projects and milestones"
    },
    "/transactions/{transactionId}": {
      "schema": "transactions",
      "description": "Escrow transaction logs"
    },
    "/mcpRules/{ruleId}": {
      "schema": "mcpRules",
      "description": "MCP routing rules"
    },
    "/gatewayConfig/{configId}": {
      "schema": "gatewayConfig",
      "description": "Gateway configuration"
    },
    "/invitationLogs/{logId}": {
      "schema": "invitationLogs",
      "description": "Invitation dispatch logs"
    }
  }
}
